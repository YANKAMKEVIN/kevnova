{
  "name": "kevnova",
  "version": "1.0.0",
  "private": true,
  "description": "NOVA STRIKE : shoot'em up vertical original (bullet hell). Rallume la dernière étoile.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:cover": "vitest run --coverage",
    "e2e": "playwright test",
    "assets": "python3 tools/assets.py",
    "check": "npm run typecheck && npm run lint && npm run test:cover && npm run build && npm run e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.11",
    "@vitest/coverage-v8": "^5.1.2",
    "eslint": "^10.15.0",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/unbounded": "^5.3.0"
  }
}
